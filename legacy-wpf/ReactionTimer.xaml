<!--
    本文件以 EmbeddedResource 方式内嵌（LogicalName 固定为 ReactionTimer.xaml），
    运行时由 Program.Main 用 XamlReader.Load 加载，因此没有 x:Class 也没有 code-behind。
    界面上的所有 x:Name 都由 ReactionController 通过 window.FindName 取用，改名会直接导致空引用。
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="反应力测试" Width="1040" Height="704" MinWidth="870" MinHeight="652"
        WindowStartupLocation="CenterScreen" Background="#14161C" Foreground="#E9EDF6"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontWeight="Medium" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="TextMain" Color="#E9EDF6"/>
        <SolidColorBrush x:Key="TextMuted" Color="#A8B2C6"/>
        <SolidColorBrush x:Key="Accent" Color="#9BC5FF"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
        </Style>
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#242832"/>
            <Setter Property="BorderBrush" Value="#39404E"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="15,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.84"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.40"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ModeButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="74"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Segment" Background="Transparent" CornerRadius="5" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Segment" Property="Background" Value="#2A2F3B"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="#D7E8FF"/>
                                <Setter TargetName="Segment" Property="Background" Value="#2B3B53"/>
                                <Setter TargetName="Segment" Property="BorderBrush" Value="#4A6386"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Segment" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.62"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid x:Name="MainContent" Margin="30,24,30,23">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,23">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Width="46" Height="46" Margin="0,1,13,0" CornerRadius="11" Background="#23334B" VerticalAlignment="Top">
                        <Path Fill="{StaticResource Accent}" Stretch="Uniform" Width="17" Height="24"
                              Data="M 11 0 L 2 13 L 9 13 L 6 23 L 19 9 L 12 9 L 16 0 Z"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="反应力测试" FontSize="30" FontWeight="SemiBold"/>
                        <TextBlock Text="看到绿色信号后，尽快点击或按空格。" Foreground="{StaticResource TextMuted}"
                                   FontSize="13" Margin="1,4,0,0"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                ToolTip="Windows 为当前窗口所在显示器设置的刷新率">
                        <TextBlock Text="刷新率" Foreground="{StaticResource TextMuted}" FontSize="13"/>
                        <TextBlock x:Name="MonitorRate" Text="—" Foreground="{StaticResource Accent}"
                                   FontSize="13" FontWeight="SemiBold" Margin="7,0,0,0"/>
                    </StackPanel>
                    <Border Width="1" Height="16" Background="#39404E" Margin="15,0" VerticalAlignment="Center"/>
                    <TextBlock Text="测试轮数" FontSize="13" Foreground="{StaticResource TextMuted}"
                               VerticalAlignment="Center" Margin="0,0,11,0"/>
                    <Border Background="#1B1E26" BorderBrush="#313643" BorderThickness="1" CornerRadius="8" Padding="3">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="FiveRounds" Content="5 轮" GroupName="Rounds" IsChecked="True" Style="{StaticResource ModeButton}"/>
                            <RadioButton x:Name="TenRounds" Content="10 轮" GroupName="Rounds" Margin="3,0,0,0" Style="{StaticResource ModeButton}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="278"/>
                </Grid.ColumnDefinitions>

                <Border Background="#1B1E26" BorderBrush="#313643" BorderThickness="1" CornerRadius="12" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="5"/>
                        </Grid.RowDefinitions>
                        <DockPanel LastChildFill="True" Margin="1,0,1,13">
                            <Button x:Name="ResetButton" DockPanel.Dock="Right" Content="重置" Style="{StaticResource FlatButton}"/>
                            <TextBlock x:Name="ProgressText" Text="已完成 0 / 5 轮" FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
                        </DockPanel>
                        <Button Grid.Row="1" x:Name="TestArea" Cursor="Hand" Background="#252D3D" Focusable="True"
                                BorderBrush="#3B4B63" BorderThickness="1" Margin="0,0,0,12">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="TestSurface" Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="9">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="TestSurface" Property="BorderThickness" Value="2"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel HorizontalAlignment="Center" Margin="14">
                                <Border x:Name="SignalHalo" Width="54" Height="54" Background="#334968" CornerRadius="27"
                                        HorizontalAlignment="Center" Margin="0,0,0,16">
                                    <Ellipse x:Name="SignalDot" Width="16" Height="16" Fill="#9BC5FF"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="SignalTitle" Text="开始测试" HorizontalAlignment="Center"
                                           FontSize="42" FontWeight="SemiBold" TextAlignment="Center"/>
                                <TextBlock x:Name="SignalHint" Text="点击此处或按空格" FontSize="15" Foreground="{StaticResource TextMuted}"
                                           Margin="0,11,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Button>
                        <ProgressBar Grid.Row="2" x:Name="ProgressMeter" Minimum="0" Maximum="5" Value="0"
                                     AutomationProperties.Name="测试进度" Focusable="False"
                                     Background="#303643" Foreground="#87B7FD" BorderThickness="0"/>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Background="#1B1E26" BorderBrush="#313643" BorderThickness="1" CornerRadius="12" Padding="17,16,17,13">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="本次成绩" FontSize="17" FontWeight="SemiBold" Margin="1,0,0,13"/>
                        <UniformGrid Grid.Row="1" Columns="2">
                            <Border Background="#242832" CornerRadius="8" Margin="0,0,4,0" Padding="10,7">
                                <StackPanel>
                                    <TextBlock Text="平均" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                                    <TextBlock x:Name="AverageText" Text="—" FontWeight="SemiBold" FontSize="21" Margin="0,1,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#242832" CornerRadius="8" Margin="4,0,0,0" Padding="10,7">
                                <StackPanel>
                                    <TextBlock Text="最快" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                                    <TextBlock x:Name="BestText" Text="—" FontWeight="SemiBold" FontSize="21" Margin="0,1,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <DockPanel Grid.Row="2" Margin="1,15,1,6">
                            <TextBlock Text="轮次" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                            <TextBlock Text="反应时间" Foreground="{StaticResource TextMuted}" FontSize="12" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <Grid Grid.Row="3" x:Name="RoundResults" VerticalAlignment="Top"/>
                    </Grid>
                </Border>
            </Grid>

            <DockPanel Grid.Row="2" Margin="1,14,1,0">
                <TextBlock x:Name="FalseStartsText" DockPanel.Dock="Right" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                <StackPanel Orientation="Horizontal">
                    <Border Background="#252A35" BorderBrush="#384050" BorderThickness="1" CornerRadius="4" Padding="7,2">
                        <TextBlock Text="空格" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                    </Border>
                    <TextBlock Text="开始 / 响应" Margin="7,0,14,0" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
                    <Border Background="#252A35" BorderBrush="#384050" BorderThickness="1" CornerRadius="4" Padding="7,2">
                        <TextBlock Text="Esc" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                    </Border>
                    <TextBlock Text="重置" Margin="7,0,0,0" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
                </StackPanel>
            </DockPanel>
        </Grid>

        <Border x:Name="RewardOverlay" Background="#D512141A" Visibility="Collapsed">
            <Border Margin="62,30" CornerRadius="14" Background="#222630" BorderBrush="#46536A" BorderThickness="1" Padding="17">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="58*"/>
                        <ColumnDefinition Width="42*"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="#181B22" CornerRadius="8">
                        <Image x:Name="RewardImage" Stretch="Uniform" Margin="4" RenderOptions.BitmapScalingMode="HighQuality"
                               AutomationProperties.Name="新年插画彩蛋"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="26,16,16,16" VerticalAlignment="Center">
                        <TextBlock Text="彩蛋已解锁" FontSize="27" FontWeight="SemiBold"/>
                        <TextBlock x:Name="RewardScore" FontSize="48" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,10,0,0"/>
                        <TextBlock x:Name="RewardRound" Foreground="{StaticResource TextMuted}" FontSize="14" Margin="0,4,0,23" TextWrapping="Wrap"/>
                        <Button x:Name="CloseReward" Content="继续测试" Style="{StaticResource FlatButton}" HorizontalAlignment="Left"
                                Background="#9BC5FF" Foreground="#152131" BorderBrush="#9BC5FF"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
