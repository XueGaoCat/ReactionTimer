<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ReactionTimer.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ReactionTimer"
    Background="Transparent">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <!--
                    暗色字典的 key 必须叫 Default —— 这是框架的历史约定，写成 Dark 在暗色下会整本找不到。

                    凡是代码会直接取用的刷子都必须放进这里，不能在外面写成
                    <StaticResource ResourceKey="...Brush"/> 的别名：
                    别名在字典加载时就把"当时系统主题"的值固化下来了，
                    手动切到深色时它不会跟着变（信号区会变成浅灰）。
                    值取自 Fluent 2 的明暗两套 token。
                -->
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="IdleSurfaceBrush" Color="#0AFFFFFF" />
                    <SolidColorBrush x:Key="TitlePrimaryBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C5C5C5" />
                    <SolidColorBrush x:Key="StrokeDefaultBrush" Color="#0FFFFFFF" />
                    <SolidColorBrush x:Key="SuccessSurfaceBrush" Color="#0E3A1F" />
                    <SolidColorBrush x:Key="SuccessFillBrush" Color="#6CCB8F" />
                    <SolidColorBrush x:Key="CriticalSurfaceBrush" Color="#442726" />
                    <SolidColorBrush x:Key="CriticalFillBrush" Color="#FF99A4" />
                    <SolidColorBrush x:Key="CautionSurfaceBrush" Color="#433519" />
                    <SolidColorBrush x:Key="CautionFillBrush" Color="#FCE100" />
                    <!--  强调色跟随系统设置，Light2 是暗色背景上用的那一档。  -->
                    <SolidColorBrush x:Key="IdleDotBrush" Color="{ThemeResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="StrokeAccentBrush" Color="{ThemeResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="AccentBrush" Color="{ThemeResource SystemAccentColorLight2}" />
                </ResourceDictionary>

                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="IdleSurfaceBrush" Color="#F9F9F9" />
                    <SolidColorBrush x:Key="TitlePrimaryBrush" Color="#1A1A1A" />
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5D5D5D" />
                    <SolidColorBrush x:Key="StrokeDefaultBrush" Color="#0F000000" />
                    <SolidColorBrush x:Key="SuccessSurfaceBrush" Color="#DFF6DD" />
                    <SolidColorBrush x:Key="SuccessFillBrush" Color="#0F7B0F" />
                    <SolidColorBrush x:Key="CriticalSurfaceBrush" Color="#FDE7E9" />
                    <SolidColorBrush x:Key="CriticalFillBrush" Color="#C42B1C" />
                    <SolidColorBrush x:Key="CautionSurfaceBrush" Color="#FFF4CE" />
                    <SolidColorBrush x:Key="CautionFillBrush" Color="#9D5D00" />
                    <SolidColorBrush x:Key="IdleDotBrush" Color="{ThemeResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="StrokeAccentBrush" Color="{ThemeResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="AccentBrush" Color="{ThemeResource SystemAccentColorDark1}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <DataTemplate x:Key="RoundRowTemplate" x:DataType="local:RoundResult">
                <Grid Height="26" ColumnDefinitions="3,*,Auto">
                    <Rectangle
                        Width="3"
                        Height="12"
                        VerticalAlignment="Center"
                        Fill="{ThemeResource AccentFillColorDefaultBrush}"
                        RadiusX="1.5"
                        RadiusY="1.5"
                        Visibility="{x:Bind BestMark}" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="7,0,0,0"
                        VerticalAlignment="Center"
                        FontFamily="Consolas"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="{x:Bind Label}" />
                    <TextBlock
                        Grid.Column="2"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="{x:Bind Weight}"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        Text="{x:Bind Display}" />
                    <Border
                        Grid.ColumnSpan="3"
                        Height="1"
                        VerticalAlignment="Bottom"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                        Opacity="0.5" />
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  自绘标题栏命中了系统按钮以外的整条区域，只留作拖拽，不重复显示标题。  -->
        <Grid
            x:Name="AppTitleBar"
            x:FieldModifier="public"
            Height="32"
            VerticalAlignment="Top" />

        <Grid
            Grid.Row="1"
            Padding="28,4,28,20"
            RowDefinitions="Auto,*,Auto">

            <!--  页头  -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <Border
                        x:Name="AppIconTile"
                        Width="56"
                        Height="56"
                        VerticalAlignment="Center">
                        <!--
                            不用 CornerRadius 蒙版，直接显示原图：PNG 四角本身是透明的。
                            用 ImageBrush 而非 Image，是为了让 Stretch 生效且不产生额外布局。
                        -->
                        <Border.Background>
                            <ImageBrush x:Name="AppIconBrush" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="反应力测试" />
                        <TextBlock
                            FontSize="13"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="看到绿色信号后，尽快点击或按空格。" />
                    </StackPanel>
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="14">
                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="6"
                        ToolTipService.ToolTip="Windows 为当前窗口所在显示器设置的刷新率">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="13"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="刷新率" />
                        <TextBlock
                            x:Name="MonitorRate"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Text="—" />
                    </StackPanel>

                    <Border
                        Width="1"
                        Height="14"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="13"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="测试轮数" />
                        <SelectorBar x:Name="RoundSelector" SelectionChanged="OnRoundSelectionChanged">
                            <SelectorBarItem
                                x:Name="FiveRounds"
                                IsSelected="True"
                                Text="5 轮" />
                            <SelectorBarItem
                                x:Name="TenRounds"
                                Tag="10"
                                Text="10 轮" />
                        </SelectorBar>
                    </StackPanel>

                    <Border
                        Width="1"
                        Height="14"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <Button
                        x:Name="ThemeButton"
                        Padding="9,6"
                        ToolTipService.ToolTip="外观">
                        <FontIcon FontSize="15" Glyph="&#xE706;" />
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <RadioMenuFlyoutItem
                                    x:Name="ThemeFollowSystem"
                                    Click="OnThemeMenuClick"
                                    GroupName="AppTheme"
                                    Tag="Default"
                                    Text="跟随系统" />
                                <RadioMenuFlyoutItem
                                    x:Name="ThemeLight"
                                    Click="OnThemeMenuClick"
                                    GroupName="AppTheme"
                                    Tag="Light"
                                    Text="浅色" />
                                <RadioMenuFlyoutItem
                                    x:Name="ThemeDark"
                                    Click="OnThemeMenuClick"
                                    GroupName="AppTheme"
                                    Tag="Dark"
                                    Text="深色" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>

            <!--  主体  -->
            <Grid Grid.Row="1" ColumnDefinitions="*,18,300">
                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource OverlayCornerRadius}">
                    <Grid RowDefinitions="Auto,*,Auto">

                        <Grid Margin="0,0,0,12" ColumnDefinitions="*,Auto">
                            <TextBlock
                                x:Name="ProgressText"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="已完成 0 / 5 轮" />
                            <Button
                                x:Name="ResetButton"
                                Grid.Column="1"
                                Click="OnResetClick"
                                Content="重置" />
                        </Grid>

                        <Border
                            x:Name="SignalSurface"
                            Grid.Row="1"
                            Margin="0,0,0,14"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <!--
                                透明按钮铺满整个信号区：点击、空格、焦点全部走原生按钮行为，
                                底色由外层 Border 承担，避免悬停态把信号色冲掉。
                                系统白色焦点框会压住信号色，关掉后改由描边颜色表达焦点。
                            -->
                            <Button
                                x:Name="TestArea"
                                Padding="0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                BorderThickness="0"
                                Click="OnTestAreaClick"
                                GotFocus="OnTestAreaGotFocus"
                                LostFocus="OnTestAreaLostFocus"
                                UseSystemFocusVisuals="False">
                                <Button.Resources>
                                    <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#10FFFFFF" />
                                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#1CFFFFFF" />
                                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                                </Button.Resources>
                                <StackPanel
                                    MaxWidth="440"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="0">
                                    <Ellipse
                                        x:Name="SignalDot"
                                        Width="14"
                                        Height="14"
                                        Margin="0,0,0,18"
                                        HorizontalAlignment="Center"
                                        Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                                    <TextBlock
                                        x:Name="SignalTitle"
                                        HorizontalAlignment="Center"
                                        FontSize="40"
                                        FontWeight="SemiBold"
                                        Text="开始测试"
                                        TextAlignment="Center" />
                                    <TextBlock
                                        x:Name="SignalHint"
                                        Margin="0,10,0,0"
                                        HorizontalAlignment="Center"
                                        FontSize="15"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="点击此处或按空格"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Button>
                        </Border>

                        <ProgressBar
                            x:Name="ProgressMeter"
                            Grid.Row="2"
                            Height="4"
                            MinHeight="4"
                            AutomationProperties.Name="测试进度"
                            Maximum="5"
                            Minimum="0"
                            Value="0" />
                    </Grid>
                </Border>

                <Border
                    Grid.Column="2"
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource OverlayCornerRadius}">
                    <Grid RowDefinitions="Auto,Auto,Auto,*">
                        <TextBlock
                            Margin="0,0,0,12"
                            FontWeight="SemiBold"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="本次成绩" />

                        <Grid
                            Grid.Row="1"
                            ColumnDefinitions="*,*"
                            ColumnSpacing="8">
                            <Border
                                Padding="12,8"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                CornerRadius="4">
                                <StackPanel Spacing="2">
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="平均" />
                                    <TextBlock
                                        x:Name="AverageText"
                                        FontSize="22"
                                        FontWeight="SemiBold"
                                        Text="—" />
                                </StackPanel>
                            </Border>
                            <Border
                                Grid.Column="1"
                                Padding="12,8"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                CornerRadius="4">
                                <StackPanel Spacing="2">
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="最快" />
                                    <TextBlock
                                        x:Name="BestText"
                                        FontSize="22"
                                        FontWeight="SemiBold"
                                        Text="—" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid
                            Grid.Row="2"
                            Margin="10,16,10,6"
                            ColumnDefinitions="*,Auto">
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="轮次" />
                            <TextBlock
                                Grid.Column="1"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="反应时间" />
                        </Grid>

                        <ScrollViewer
                            Grid.Row="3"
                            Padding="0,0,2,0"
                            VerticalScrollBarVisibility="Auto">
                            <ItemsRepeater x:Name="RoundResults" ItemTemplate="{StaticResource RoundRowTemplate}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Vertical" Spacing="0" />
                                </ItemsRepeater.Layout>
                            </ItemsRepeater>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!--  页脚  -->
            <Grid
                Grid.Row="2"
                Margin="2,16,2,0"
                ColumnDefinitions="*,Auto">
                <!--  版本与署名，文本由代码按程序集版本拼出来。  -->
                <TextBlock
                    x:Name="VersionLabel"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock
                    x:Name="FalseStartsText"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Grid>
    </Grid>
</Page>
